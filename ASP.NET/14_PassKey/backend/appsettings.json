{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
  },
  "Hanko": {
    "InternalApiUrl": "http://localhost:8000",
    "CookieName": "hanko",
    "ValidateAudience": false,
    "ValidAudiences": [],
    "ValidateSessionRemotely": false
  },
  "ReverseProxy": {
    "Routes": {
      "hanko-public": {
        "ClusterId": "hanko",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      }
    },
    "Clusters": {
      "hanko": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8000/"
          }
        }
      }
    }
  }
}
